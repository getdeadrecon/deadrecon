## DeadRecon .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.env
.env.*
!.env.example

# DeadRecon runtime
deadrecon.db
deadrecon.db-shm
deadrecon.db-wal
phantomsignal.db
phantomsignal.db-shm
phantomsignal.db-wal
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
exports/
*.enc
/data/
instance/

# API keys — NEVER commit these
config/deadrecon.yaml
config/phantomsignal.yaml
config/*.yaml
config/*.json
config/*.toml
config/*.yml
secret_key
.deadrecon/
.phantomsignal/
.pypirc
.netrc

# Scrapy
.scrapy/
scrapy.cfg

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# Claude Code local settings
.claude/

# Docker
.docker/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Playwright
playwright-report/
test-results/

# Certificates
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Temp
*.tmp
*.bak
tmp/
temp/

# DeadRecon scan data / exports
/scans/
/reports/
/screenshots/
*.kml
*.geojson

# Test suite — deliberately private, never force-add
/tests/

# Internal planning doc — kept local, mirrored in Claude memory
ROADMAP.md
